# Pinned versions of third-party images and toolchains (spec §11.5).
# Consumed by `pnpm dev:up` and CI via `docker compose --env-file infra/versions.env`.
# compose.yaml / Dockerfiles carry the same values as defaults, so a plain
# `docker compose -f infra/compose.yaml -f infra/compose.dev.yaml up --build` works too —
# keep both in sync when bumping.
NODE_IMAGE=node:22-alpine
POSTGRES_IMAGE=postgres:16
CADDY_IMAGE=caddy:2.10-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.27
