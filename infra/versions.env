# Pinned versions of third-party images and toolchains (spec §11.5).
# Consumed by `pnpm dev:up` and CI via `docker compose --env-file infra/versions.env`.
# compose.yaml / Dockerfiles carry the same values as defaults, so a plain
# `docker compose -f infra/compose.yaml -f infra/compose.dev.yaml up --build` works too —
# keep both in sync when bumping.
NODE_IMAGE=node:22-alpine
POSTGRES_IMAGE=postgres:16
CADDY_IMAGE=caddy:2.10-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.27

# VPS host components, installed by infra/scripts/bootstrap-vps.sh (spec §6.3, §11.5).
# Bumped by hand: drain the sandboxes, edit these lines, re-run bootstrap-vps.sh, then practice:test --all.
# DOCKER_VERSION is the Docker Engine (docker-ce) version from download.docker.com; bootstrap holds it.
DOCKER_VERSION=29.9.2
# Sysbox CE .deb from https://github.com/nestybox/sysbox/releases and its published sha256.
SYSBOX_VERSION=0.7.1
SYSBOX_DEB_SHA256=9d6d5484f980d0a17f86c492c1262015c2afb66280bdb97215b79fde6a0261c5
