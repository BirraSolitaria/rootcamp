# Template for infra/vps.env on the VPS test stand (docs/deploy/vps.md).
#   cp infra/vps.env.example infra/vps.env && chmod 600 infra/vps.env
# infra/vps.env holds real secrets: it is git-ignored and never leaves the server.
# Placeholders only below; empty required values make `docker compose` stop with an error.

# Exactly the address typed in the browser: scheme + host + port, no trailing slash.
# Every POST from any other origin gets 403 csrf.
PUBLIC_ORIGIN=http://203.0.113.10:8080
# false while the stand is plain http (a Secure cookie is not kept over http).
COOKIE_SECURE=false
# Where the site port is published: 8080 (all interfaces) or 127.0.0.1:8080 (SSH tunnel only).
SITE_BIND=8080

# Mailpit UI (test letters). Default: bound to 127.0.0.1:8025, reachable only via an SSH tunnel.
# To open it as http://<IP>:8025 set MAILPIT_BIND=8025 AND MAILPIT_UI_AUTH_FILE (compose refuses
# MAILPIT_BIND without it): letters hold verify/reset links, an open Mailpit = account takeover.
# The auth file is one "user:password" line (htpasswd hashes also work), path relative to infra/:
#   printf 'rootcamp:%s\n' "$(openssl rand -base64 18 | tr -d '/+=')" > infra/mailpit-ui.auth
#   chmod 600 infra/mailpit-ui.auth   # git-ignored, read the login with: cat infra/mailpit-ui.auth
MAILPIT_BIND=
MAILPIT_UI_AUTH_FILE=

# Generate: openssl rand -hex 24  (hex keeps DATABASE_URL valid without escaping).
POSTGRES_PASSWORD=
# Generate: openssl rand -hex 32  (each must be at least 16 characters).
INTERNAL_TOKEN=
TICKET_SECRET=

# Real SMTP (leave SMTP_HOST empty to keep Mailpit). Port 465 = implicit TLS, 587 = STARTTLS.
# Example for Yandex: SMTP_HOST=smtp.yandex.ru SMTP_PORT=465 SMTP_USER=box@yandex.ru
# SMTP_PASS=<app password> SMTP_FROM=rootcamp <box@yandex.ru>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Only with compose.vps-tls.yaml: the domain whose A record points at the VPS.
DOMAIN=

# Optional rate-limit overrides (empty = production values). See apps/api/src/config.ts.
RATE_LIMIT_REGISTER_IP_PER_HOUR=
RATE_LIMIT_LOGIN_IP_PER_MIN=
