{
  "name": "@rootcamp/sandboxd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch --conditions=rootcamp-src src/server.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.4",
    "@rootcamp/api-contract": "workspace:*",
    "@rootcamp/db": "workspace:*",
    "dockerode": "4.0.12",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/dockerode": "4.0.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "ws": "8.22.0"
  }
}
